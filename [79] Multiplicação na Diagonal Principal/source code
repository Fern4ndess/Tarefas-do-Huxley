#include <stdio.h>

int main() {
    int k, matriz[4][4];
    
    while(1) { // enquanto k for diferente de 0, novas matrizes surgirão
        
        scanf("%d", &k); // constante k
        if( k == 0 ) break;
    
        for( int a = 0 ; a < 4 ; a++ ) { // scan, de coluna pra coluna
            for( int b = 0 ; b < 4 ; b++ ) {
            
                scanf("%d" , &matriz[b][a] );
            
                if( b == a ) {
                    matriz[b][a] *= k;
                }
            
            }
        }
        for( int a = 0 ; a < 4 ; a++ ) { 
            for( int b = 0 ; b < 4 ; b++ ) {
                printf("%d ", matriz[a][b]);
            }
        printf("\n");
        }
    
    }
    
    return 0;
}